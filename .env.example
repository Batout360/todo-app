# Database Configuration
# Use DATABASE_URL for a single connection string (Postgres/MySQL)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Or use individual variables (defaults to MySQL on localhost:3306)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=todo_app
DB_DIALECT=mysql

# JWT Secret for Auth
JWT_SECRET=your-very-secret-key

# Vercel Blob (Optional, for Avatars)
# BLOB_READ_WRITE_TOKEN=your_token_here

# Server Port
PORT=3000
NODE_ENV=development
